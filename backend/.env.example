# Providers: "fake" returns canned data (no keys needed); "google" uses the real APIs below.
VISION_PROVIDER=fake
INSPIRATION_PROVIDER=fake

# Path to a GCP service-account JSON with the Cloud Vision API enabled. Keep it outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# Google Programmable Search (Custom Search JSON API) — shuts down 2027-01-01.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=
