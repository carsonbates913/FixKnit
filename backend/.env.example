# Providers: "fake" returns canned data (no keys needed); "google" uses the real APIs below.
VISION_PROVIDER=fake
INSPIRATION_PROVIDER=fake

# Path to a GCP service-account JSON with the Cloud Vision API enabled. Keep it outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# Google Programmable Search (Custom Search JSON API) — shuts down 2027-01-01.
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Postgres + Supabase. These defaults match `supabase start` (local development keys, not secrets).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
# Local secret key: run `npx supabase status` and copy SECRET_KEY.
SUPABASE_SECRET_KEY=
ADVISOR_PROVIDER=fake
